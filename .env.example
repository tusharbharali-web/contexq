# ==============================================================================
# ContexQ chatbot: Groq (free tier)
# ==============================================================================
# Server-only. Never prefix with NEXT_PUBLIC_ (that would expose it to browsers).
# Create a key at console.groq.com > API Keys. On Netlify, add the same variables
# under Site configuration > Environment variables.
GROQ_API_KEY=
# Main model and fallback model (each has its own free allowance).
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# ==============================================================================
# Cookies, analytics and leads. Leave a value empty and that feature stays off.
# ==============================================================================

# --- Public IDs (safe to be visible in the browser) ---
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX
#   GA4 > Admin > Data collection and modification > Data streams > (web stream) > Measurement ID
NEXT_PUBLIC_GA_ID=
# Microsoft Clarity project ID
#   clarity.microsoft.com > your project > Settings > Overview > Project ID
NEXT_PUBLIC_CLARITY_ID=
# Leadfeeder tracker ID: the text after "lftracker_v1_" in your tracker script
#   Leadfeeder > Settings (gear) > Website tracker > Tracker script. The full script URL also works.
NEXT_PUBLIC_LEADFEEDER_ID=

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
# IPinfo Lite token: ipinfo.io > Dashboard > Token
IPINFO_TOKEN=
# Cloudflare Turnstile SECRET key for the contact form (the site key is already in the page)
#   Cloudflare dashboard > Turnstile > your widget > Settings > Secret key
TURNSTILE_SECRET_KEY=
# FormSubmit endpoint ID that emails each lead: the part after formsubmit.co/ in your FormSubmit URL
LEADS_FORMSUBMIT_ID=
# Optional: extra recipients for lead emails, comma separated
LEADS_CC_EMAILS=
# Optional: Google Sheet logging. Web app URL from scripts/google-sheet-leads.gs, and a shared secret
LEADS_SHEET_WEBHOOK_URL=
LEADS_SHEET_SECRET=
